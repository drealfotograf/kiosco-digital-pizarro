{
  "name": "kiosco-pizarro",
  "productName": "Kiosco Digital Pizarro",
  "version": "0.1.0",
  "description": "Kiosco táctil de impresión fotográfica, fotos carnet y envío a laboratorio",
  "type": "module",
  "main": "main/main.js",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "dev": "vite build && electron . --dev",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@napi-rs/canvas": "^1.1.1",
    "express": "^4.21.2",
    "heic-convert": "^2.1.0",
    "imapflow": "^1.0.188",
    "mailparser": "^3.7.2",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "es.pizarro.kiosco",
    "productName": "Kiosco Digital Pizarro",
    "directories": {
      "output": "installer"
    },
    "files": [
      "main/**",
      "shared/**",
      "dist-renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "main/scripts/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/@napi-rs/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["es_ES"],
      "language": "1034",
      "shortcutName": "Kiosco Pizarro"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "sharp@0.34.5": true,
    "esbuild@0.25.12": true
  }
}
